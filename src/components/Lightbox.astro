---
// Click-to-enlarge for images in documentation content.
// Rendered once per page via SiteFooter.astro.
---

<dialog id="lightbox" class="lightbox" aria-label="Enlarged image">
	<button class="lightbox-close" type="button" aria-label="Close image">
		<svg
			aria-hidden="true"
			viewBox="0 0 24 24"
			width="20"
			height="20"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
		>
			<path d="M6 6l12 12M18 6L6 18" />
		</svg>
	</button>
	<figure class="lightbox-figure">
		<img class="lightbox-img" alt="" />
		<figcaption class="lightbox-caption"></figcaption>
	</figure>
</dialog>

<style is:global>
	/* Affordance on enlargeable images */
	img[data-zoomable] {
		cursor: zoom-in;
		border-radius: 0.4rem;
		transition: box-shadow 0.15s ease;
	}
	img[data-zoomable]:hover {
		box-shadow: 0 0 0 3px var(--sl-color-accent-low);
	}

	.lightbox {
		width: 100%;
		height: 100%;
		max-width: 100%;
		max-height: 100%;
		border: none;
		padding: 0;
		background: transparent;
		overflow: hidden;
	}
	.lightbox::backdrop {
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(4px);
	}
	.lightbox:not([open]) {
		display: none;
	}

	.lightbox-figure {
		margin: 0;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.85rem;
		padding: 2.5rem 1.5rem;
		box-sizing: border-box;
	}
	.lightbox-img {
		max-width: min(96vw, 1600px);
		max-height: 86vh;
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: 0.4rem;
		box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.5);
	}
	.lightbox-caption {
		color: #e3e8ed;
		font-size: 0.85rem;
		text-align: center;
		max-width: 60ch;
		text-wrap: balance;
	}
	.lightbox-caption:empty {
		display: none;
	}

	.lightbox-close {
		position: fixed;
		top: 1rem;
		right: 1rem;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.5);
		color: #fff;
		cursor: pointer;
		transition:
			background 0.15s ease,
			border-color 0.15s ease;
	}
	.lightbox-close:hover {
		background: rgba(0, 0, 0, 0.8);
		border-color: var(--sl-color-accent);
	}

	@media (prefers-reduced-motion: no-preference) {
		.lightbox[open] .lightbox-figure {
			animation: lightbox-in 0.18s ease-out;
		}
		@keyframes lightbox-in {
			from {
				opacity: 0;
				transform: scale(0.97);
			}
		}
	}
</style>

<script>
	function setupLightbox() {
		const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
		if (!dialog) return;

		const img = dialog.querySelector('.lightbox-img') as HTMLImageElement;
		const caption = dialog.querySelector('.lightbox-caption') as HTMLElement;
		const closeBtn = dialog.querySelector('.lightbox-close') as HTMLButtonElement;

		// Pick the highest-resolution candidate Astro generated for this image.
		function bestSource(source: HTMLImageElement) {
			const srcset = source.getAttribute('srcset');
			if (!srcset) return source.currentSrc || source.src;
			let bestUrl = source.src;
			let bestVal = -1;
			for (const entry of srcset.split(',')) {
				const [url, descriptor] = entry.trim().split(/\s+/);
				if (!url) continue;
				const val = descriptor ? parseFloat(descriptor) : 1;
				if (!Number.isNaN(val) && val > bestVal) {
					bestVal = val;
					bestUrl = url;
				}
			}
			return bestUrl;
		}

		function open(source: HTMLImageElement) {
			img.src = bestSource(source);
			img.alt = source.alt || '';
			caption.textContent = source.alt || '';
			dialog.showModal();
			document.body.style.overflow = 'hidden';
		}

		function close() {
			dialog.close();
		}

		// Docs content images, plus figures on the custom landing page.
		const roots = document.querySelectorAll('.sl-markdown-content, .landing .figure');
		for (const root of roots) {
			for (const candidate of root.querySelectorAll('img')) {
				// Skip images that are already links — the link wins.
				if (candidate.closest('a')) continue;
				candidate.dataset.zoomable = '';
				candidate.addEventListener('click', () => open(candidate));
			}
		}

		closeBtn.addEventListener('click', close);

		// Click anywhere outside the image closes.
		dialog.addEventListener('click', (event) => {
			if (event.target !== img) close();
		});

		// Restore scrolling however the dialog was dismissed (button, backdrop, Esc).
		dialog.addEventListener('close', () => {
			document.body.style.overflow = '';
			img.removeAttribute('src');
		});
	}

	setupLightbox();
	document.addEventListener('astro:page-load', setupLightbox);
</script>
