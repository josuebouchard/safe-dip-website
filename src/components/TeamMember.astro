---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	email?: string;
	role: string;
	photo: ImageMetadata;
}

const { name, email, role, photo } = Astro.props;
---

<div class="member not-content">
	<Image class="member-photo" src={photo} alt={name} width={200} densities={[1, 2]} />

	<div class="member-info">
		{
			email && (
				<a class="member-email" href={`mailto:${email}`}>
					<svg
						aria-hidden="true"
						viewBox="0 0 24 24"
						width="15"
						height="15"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<rect x="2" y="4" width="20" height="16" rx="2" />
						<path d="m2 7 10 6 10-6" />
					</svg>
					{email}
				</a>
			)
		}

		<p class="member-role">{role}</p>

		<div class="member-bio">
			<slot />
		</div>
	</div>
</div>

<style>
	.member {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 1.75rem;
		align-items: start;
		margin-block: 1.25rem 2.5rem;
	}

	.member-photo {
		width: 200px;
		height: 200px;
		object-fit: cover;
		border-radius: 0.6rem;
		border: 1px solid var(--sl-color-gray-5);
	}

	.member-info {
		min-width: 0;
	}

	.member-email {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--sl-color-accent-high);
		font-size: var(--sl-text-sm);
		text-decoration: none;
		overflow-wrap: anywhere;
	}
	.member-email:hover {
		text-decoration: underline;
	}
	.member-email svg {
		flex: none;
		opacity: 0.8;
	}

	.member-role {
		margin: 0.5rem 0 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.55;
	}
	/* Only draw the divider above the role when there's an email above it. */
	.member-email + .member-role {
		padding-top: 0.5rem;
		border-top: 1px solid var(--sl-color-gray-6);
	}

	.member-bio {
		margin-top: 0.9rem;
		line-height: 1.7;
	}
	.member-bio :global(p) {
		margin: 0;
	}
	.member-bio :global(p + p) {
		margin-top: 0.75rem;
	}

	@media (max-width: 45rem) {
		.member {
			grid-template-columns: 1fr;
			gap: 1.1rem;
			justify-items: start;
		}
	}
</style>
