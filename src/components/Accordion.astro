---
interface Props {
	title: string;
	subtitle?: string;
	open?: boolean;
}

const { title, subtitle, open = false } = Astro.props;
---

<details class="accordion" open={open}>
	<summary class="accordion-summary">
		<span class="accordion-heading">
			<span class="accordion-title">{title}</span>
			{subtitle && <span class="accordion-subtitle">{subtitle}</span>}
		</span>
	</summary>
	<div class="accordion-body">
		<slot />
	</div>
</details>

<style>
	.accordion {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-bg-nav);
		margin-block: 0.6rem;
		overflow: hidden;
	}
	.accordion[open] {
		border-color: var(--sl-color-accent);
	}

	.accordion-summary {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.85rem 1rem;
		cursor: pointer;
		list-style: none;
		user-select: none;
		transition: background 0.15s ease;
	}
	.accordion-summary::-webkit-details-marker {
		display: none;
	}
	.accordion-summary:hover {
		background: var(--sl-color-accent-low);
	}
	.accordion-summary:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}

	.accordion-heading {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.15rem 0.65rem;
		min-width: 0;
	}
	.accordion-title {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.accordion-subtitle {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	.accordion-body {
		padding: 0.25rem 1rem 1rem;
		border-top: 1px solid var(--sl-color-gray-6);
	}
	/* First child inside the panel shouldn't add a second gap under the divider. */
	.accordion-body > :global(:first-child) {
		margin-top: 0.85rem;
	}
	.accordion-body > :global(:last-child) {
		margin-bottom: 0;
	}

	/* Starlight gives content <details> its own left border, padding and
	   open-state margin. This component draws its own card, so neutralize those
	   and keep only Starlight's built-in summary marker. */
	:global(.sl-markdown-content) .accordion {
		border-inline-start-width: 1px;
		padding-inline-start: 0;
	}
	:global(.sl-markdown-content) .accordion[open] > .accordion-summary {
		margin-bottom: 0;
	}
</style>
